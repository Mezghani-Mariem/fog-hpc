# Copier ce fichier en .env puis adapter. Ne jamais commiter .env.
# Fog-1 => fog-1 ; Fog-2 => fog-2 ; Fog-3 => fog-3
NODE_ID=fog-3
MAX_RUNNING=2

# Fog-1 uniquement. Test local sur ton PC :
FOG_NODES=http://host.docker.internal:8001
# Vrai deploiement (remplacer par les vraies IP) :
# FOG_NODES=http://IP1:8001,http://IP2:8001,http://IP3:8001
